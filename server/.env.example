# ==========================================
# LifeLine Backend Environment Configuration
# ==========================================

# Core Server Configuration
PORT=5001
NODE_ENV=development

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://localhost:27017/lifeline

# Authentication Secrets (JWT - Minimum 16 characters each)
JWT_ACCESS_SECRET=your_jwt_access_secret_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------
# Deferred Integrations (Optional for M0)
# ------------------------------------------

# Razorpay Payment Gateway (Milestone 7)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# LiveKit Cloud Video Infrastructure (Milestone 8)
LIVEKIT_URL=https://your-project.livekit.cloud
LIVEKIT_API_KEY=placeholder_livekit_api_key
LIVEKIT_API_SECRET=placeholder_livekit_api_secret

# Cloud Object Storage - S3 / R2 (Milestone 9)
STORAGE_BUCKET=lifeline-medical-records
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=placeholder_storage_access_key
STORAGE_SECRET_KEY=placeholder_storage_secret_key
STORAGE_ENDPOINT=https://s3.us-east-1.amazonaws.com

# Email Service - Resend / SMTP (Milestone 11)
RESEND_API_KEY=re_placeholder_resend_api_key
EMAIL_FROM=notifications@lifeline-telehealth.com

# AI Healthcare Assistant Service - Gemini / LLM (Milestone 12)
AI_API_KEY=placeholder_gemini_api_key
AI_MODEL=gemini-1.5-pro
